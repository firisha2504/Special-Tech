# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:5174

# Database Configuration (PostgreSQL ONLY with Prisma ORM)
DATABASE_URL="postgresql://username:password@localhost:5432/special_tech?schema=public"

# Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration (Supports GEMINI / OPENAI / GROQ / BUILT-IN)
AI_PROVIDER="built-in"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Email Configuration (Nodemailer)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Special Tech <contact@specialtech.com>"

# Uploads
UPLOAD_DIR="uploads"
